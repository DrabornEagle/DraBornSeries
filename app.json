{
  "expo": {
    "name": "DraBornSeries",
    "slug": "drabornseries",
    "scheme": "drabornseries",
    "version": "0.7.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icons/icon.png",
    "splash": {
      "image": "./assets/icons/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09080f"
    },
    "android": {
      "package": "com.draborneagle.drabornseries",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.draborneagle.com",
              "pathPrefix": "/DraBornSeries"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "DraBornSeries",
      "favicon": "./assets/icons/icon.png"
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafını cihazından seçebilmen için fotoğraflarına erişim gerekir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-play-android.cjs"
    ],
    "experiments": {
      "baseUrl": "/DraBornSeries"
    }
  }
}
