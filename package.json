{
  "name": "drabornseries",
  "version": "0.7.3",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --lan",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs && python3 tests/caption-queue.test.py",
    "check": "npm run typecheck && npm test",
    "prepare:subtitles": "node --import tsx scripts/prepare-subtitles.mjs",
    "build:web": "npm run prepare:subtitles && expo export --platform web && node --import tsx scripts/finalize-web.mjs",
    "export:android": "expo export --platform android --output-dir dist-android",
    "sync:web": "node scripts/sync-web.mjs",
    "db:new": "npx --yes supabase@2.118.0 migration new"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.7",
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.117.2",
    "expo": "58.0.0-preview.7",
    "expo-constants": "58.0.7",
    "expo-dev-client": "~58.0.7",
    "expo-file-system": "58.0.3",
    "expo-font": "58.0.2",
    "expo-iap": "5.8.2",
    "expo-image-manipulator": "58.0.8",
    "expo-image-picker": "58.0.7",
    "expo-linear-gradient": "58.0.1",
    "expo-linking": "58.0.7",
    "expo-network": "58.0.1",
    "expo-screen-orientation": "58.0.0",
    "expo-splash-screen": "58.0.4",
    "expo-status-bar": "58.0.1",
    "expo-video": "58.0.3",
    "expo-web-browser": "58.0.2",
    "hls.js": "1.6.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.1",
    "react-native-google-mobile-ads": "17.2.0",
    "react-native-safe-area-context": "5.9.1",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-expo": "58.0.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
